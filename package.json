{
  "name": "mizen",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "benchmark:cli": "pnpm --filter @mizen/cli benchmark",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "turbo run lint",
    "lint:check": "ultracite check && turbo run lint",
    "lint:fix": "ultracite fix",
    "release:check": "pnpm --filter @mizen/cli release:check",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@biomejs/biome": "2.5.15",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "ultracite": "8.0.2"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.11.0"
  }
}
