{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "with": ["@mizen-labs/docs#dev", "@mizen-labs/ui#dev"],
      "cache": false,
      "persistent": true
    },
    "@mizen-labs/ui#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
