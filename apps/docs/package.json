    "@stylexjs/stylex": "^0.19.1",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/charts": "1.1.0",
    "@tanstack/react-table": "9.3.1",
    "next": "^16.4.3",
    "pele": "1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "^8.5.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "21.0.4",
