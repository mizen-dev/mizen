{
  "name": "@mizen/docs",
  "private": true,
  "scripts": {
    "build": "next build --turbopack",
    "components:capture": "node scripts/capture-component-previews.mjs",
    "components:compare": "node scripts/compare-captures.mjs",
    "dev": "next dev --turbopack",
    "docs:sync": "node scripts/sync-example-sources.mjs && biome format --write app/example-sources.json",
